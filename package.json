{
  "name": "dsh-permission-remote",
  "version": "0.8.2",
  "private": false,
  "description": "SSH remote workspaces for the dsh web GUI, reusing the session sandbox mode and approval flow.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weicy98/dsh-permission-remote.git"
  },
  "homepage": "https://github.com/weicy98/dsh-permission-remote#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.spec.ts"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.11",
    "asn1": "^0.2.6",
    "bcrypt-pbkdf": "^1.0.2"
  },
  "optionalDependencies": {
    "@vscode/ripgrep-darwin-arm64": "^1.15.11",
    "@vscode/ripgrep-darwin-x64": "^1.15.11",
    "@vscode/ripgrep-linux-arm64": "^1.15.11",
    "@vscode/ripgrep-linux-x64": "^1.15.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/semver": "^7.8.0",
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.25.9",
    "semver": "^7.8.5",
    "typescript": "^5.9.3"
  }
}
